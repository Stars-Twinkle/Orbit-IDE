{
  "name": "orbit-ide",
  "version": "1.0.0",
  "description": "Orbit IDE — 双模式 AI 原生集成开发环境",
  "main": "src/main/main.cjs",
  "author": "Orbit Labs",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:web": "vite build",
